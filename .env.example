# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# --- database ---
DB_USERNAME=shopvault
DB_PASSWORD=
# Set by docker-compose; set it yourself when running the jar directly:
# DB_URL=jdbc:postgresql://localhost:5432/shopvault

# --- tokens ---
# Base64, at least 32 bytes decoded.
JWT_SECRET=
JWT_ISSUER=shopvault
JWT_AUDIENCE=shopvault-api

# --- payments ---
PAYMENT_PROVIDER=simulated
# Shared secret your payment provider uses to sign webhooks (32+ characters).
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CHECKOUT_BASE_URL=https://pay.example.com/checkout

# --- browser clients (comma separated, https only) ---
CORS_ALLOWED_ORIGINS=https://shop.example.com

# --- first admin (remove both after the first successful start) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- optional ---
# SHOP_CURRENCY=MYR
# FORWARD_HEADERS_STRATEGY=native   # 'none' if not behind a reverse proxy
